'use strict';
/* v2.4.0-alpha2.1: kattinthato neves szobak + egyetlen belepesi PIN. */
const http=require('http'),net=require('net'),{spawn}=require('child_process'),crypto=require('crypto'),qs=require('querystring');
const PORT=Number(process.env.PORT||80),HOST='127.0.0.1',MAX_ROOMS=10,IDLE_MS=7200000,rooms=new Map();
const NAMES=['VIDAM-MOKUS','TANCOS-ROKA','CSILLAG-CSIGA','BATOR-SUNI','KACAGO-MACI','VILLAM-KUTYA','MALNA-MANÓ','KAVICS-KIRALY','FELHO-FUTAR','TULIPAN-TIGRIS','DIOS-DINO','NAPOS-NYUSZI','BOGYO-BAGOLY','ALMA-ASZ','BARACK-BUVAR','FENYO-FONOK','CSUPA-CSODA','PAJZAN-PINGVIN'];
const clean=(s,n=64)=>String(s||'').replace(/[<>\x00-\x1f]/g,'').trim().slice(0,n);
const pin4=()=>String(Math.floor(1000+Math.random()*9000)),token=()=>crypto.randomBytes(24).toString('hex');
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#39;'}[c]));
function roomName(){let free=NAMES.filter(n=>!rooms.has(n));if(!free.length)throw Error('Jelenleg nincs több szabad szobanév.');return free[Math.floor(Math.random()*free.length)]}
function cookies(req){return Object.fromEntries(String(req.headers.cookie||'').split(';').map(x=>x.trim().split('=').map(decodeURIComponent)).filter(x=>x[0]))}
function setCookie(res,n,v,p){res.setHeader('Set-Cookie',`${encodeURIComponent(n)}=${encodeURIComponent(v)}; Path=${p}; HttpOnly; SameSite=Lax; Max-Age=7200`)}
function readBody(req){return new Promise((ok,no)=>{let b='';req.on('data',d=>{b+=d;if(b.length>16384)req.destroy()});req.on('end',()=>{try{ok(req.headers['content-type']?.includes('json')?JSON.parse(b||'{}'):qs.parse(b))}catch(e){no(e)}});req.on('error',no)})}
function freePort(){return new Promise((ok,no)=>{let s=net.createServer();s.listen(0,HOST,()=>{let p=s.address().port;s.close(()=>ok(p))});s.on('error',no)})}
function waitForPort(port,child,timeout=8000){return new Promise((ok,no)=>{let start=Date.now(),timer=setInterval(()=>{if(child.exitCode!==null){clearInterval(timer);return no(Error(`A szobaszerver leallt indulaskor (exit ${child.exitCode}).`))}let s=net.createConnection({host:HOST,port});s.once('connect',()=>{s.destroy();clearInterval(timer);ok()});s.once('error',()=>{s.destroy();if(Date.now()-start>timeout){clearInterval(timer);no(Error('A szobaszerver nem indult el 8 masodperc alatt.'))}})},100)})}
async function createRoom(){if(rooms.size>=MAX_ROOMS)throw Error('Most elértük a 10 aktív szobás korlátot.');let name=roomName(),port=await freePort(),r={name,port,pin:pin4(),access:token(),touch:Date.now()};let child=spawn(process.execPath,['server.js'],{cwd:__dirname,env:{...process.env,PORT:String(port)},stdio:['ignore','pipe','pipe']});r.child=child;rooms.set(name,r);child.stdout.on('data',d=>console.log(`[${name}] ${String(d).trim()}`));child.stderr.on('data',d=>console.error(`[${name}] ${String(d).trim()}`));child.on('exit',(c,s)=>{console.error(`[${name}] leallt: code=${c} signal=${s}`);rooms.delete(name)});try{await waitForPort(port,child);return r}catch(e){child.kill('SIGTERM');rooms.delete(name);throw e}}
function page(content,title='Ország-Város'){return`<!doctype html><html lang="hu"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title><style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui;background:radial-gradient(circle at 30% 15%,#523798,#17102f);color:#2a2140}.box{width:min(94%,620px);background:#fff;padding:1.4rem;border-radius:24px;box-shadow:0 20px 70px #0007}h1,h2{color:#6842d8}.primary,button,.button{display:block;width:100%;border:0;border-radius:14px;padding:1rem;font:700 1.05rem system-ui;cursor:pointer;text-align:center;text-decoration:none}.primary{background:linear-gradient(135deg,#6842d8,#9262f4);color:#fff}.rooms{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;margin:1rem 0}.room{display:block;border:2px solid #e4dcfa;border-radius:16px;padding:1rem;text-decoration:none;color:#30234e;background:#f8f6ff;transition:.15s}.room:hover{border-color:#8f69e8;transform:translateY(-2px)}.room b{display:block;color:#6842d8;font-size:1.3rem}.room small{color:#7d7391}input{width:100%;padding:1rem;border:2px solid #ddd3f6;border-radius:14px;font-size:1.15rem;margin:.5rem 0}.name{font-size:2.4rem;text-align:center;color:#6842d8;font-weight:900}.pin{font-size:2rem;letter-spacing:.2em;text-align:center;background:#f4f1ff;padding:1rem;border-radius:16px}.msg{background:#ffe5e5;padding:.7rem;border-radius:12px;color:#9d2531}.hint{color:#776d91;font-size:.9rem}.empty{text-align:center;color:#7d7391;padding:1rem}@media(max-width:520px){.rooms{grid-template-columns:1fr}}</style></head><body><section class="box">${content}</section></body></html>`}
function landing(msg=''){let list=[...rooms.values()].map(r=>`<a class="room" href="/join/${encodeURIComponent(r.name)}"><b>${esc(r.name)}</b><small>Kattints a belépéshez</small></a>`).join('');return page(`<h1>🌍 Ország-Város</h1><p>Válassz egy aktív szobát, majd add meg a PIN-t.</p>${msg?`<p class="msg">${esc(msg)}</p>`:''}<div class="rooms">${list||'<div class="empty">Még nincs aktív szoba.</div>'}</div><form method="post" action="/api/rooms"><button class="primary">＋ Új játék létrehozása</button></form>`)}
function pinPage(r,msg=''){return page(`<h1>Belépés</h1><p class="name">${esc(r.name)}</p>${msg?`<p class="msg">${esc(msg)}</p>`:''}<form method="post" action="/api/join/${encodeURIComponent(r.name)}"><input name="pin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="one-time-code" placeholder="4 jegyű PIN" required autofocus><button class="primary">Belépés a szobába</button></form><p class="hint"><a href="/">Vissza a szobákhoz</a></p>`,`Belépés: ${r.name}`)}
function created(r){return page(`<h1>✅ A szoba elkészült</h1><p class="name">${esc(r.name)}</p><p>Belépési PIN:</p><p class="pin">${r.pin}</p><p class="hint">Ezt a PIN-t add meg a többi játékosnak.</p><a class="button primary" href="/r/${encodeURIComponent(r.name)}/">Belépés a játékba</a>`,`Szoba: ${r.name}`)}
function deny(res){res.writeHead(404,{'content-type':'text/html;charset=utf-8','cache-control':'no-store'});res.end(landing('A szoba nem található vagy a PIN hibás.'))}
const allowed=(req,r)=>cookies(req).ov_room_access===r.access;
function badge(html,r){let tag=`<script>window.OV_ROOM_NAME=${JSON.stringify(r.name)};window.OV_ROOM_PIN=${JSON.stringify(r.pin)};(function(){function a(){if(document.getElementById('ov-room'))return;let e=document.createElement('div');e.id='ov-room';e.innerHTML='<div><small>Szoba</small><b>${esc(r.name)}</b></div><button id="ov-pin" title="Kattints a másoláshoz"><small>PIN</small><b>${r.pin}</b></button>';document.body.appendChild(e);document.getElementById('ov-pin').onclick=async()=>{let txt='Ország-Város – '+window.OV_ROOM_NAME+' szoba, PIN: '+window.OV_ROOM_PIN+'\n'+location.origin;try{await navigator.clipboard.writeText(txt);document.getElementById('ov-pin').classList.add('copied');setTimeout(()=>document.getElementById('ov-pin').classList.remove('copied'),900)}catch(e){prompt('Másold ki:',txt)}}}document.readyState==='loading'?document.addEventListener('DOMContentLoaded',a):a()})();</script><style>#ov-room{position:fixed;right:.7rem;bottom:.7rem;z-index:9999;display:flex;align-items:stretch;gap:.35rem;padding:.35rem;border-radius:15px;background:#17102ee8;color:#fff;font-family:system-ui;box-shadow:0 6px 22px #0006}#ov-room>div,#ov-pin{display:flex;flex-direction:column;justify-content:center;padding:.3rem .6rem;border-radius:11px}#ov-room small{opacity:.7;font-size:.7rem}#ov-room b{font-size:1rem;color:#ffd765;white-space:nowrap}#ov-pin{width:auto;border:0;background:#ffffff16;color:#fff;cursor:pointer}#ov-pin b{font-size:1.25rem;letter-spacing:.16em}#ov-pin.copied{background:#239c65}#ov-pin.copied:after{content:'Másolva';position:absolute;right:.4rem;top:-1.6rem;background:#239c65;padding:.18rem .45rem;border-radius:8px;font-size:.7rem}</style>`;return html.replace('</body>',tag+'</body>')}
function proxy(req,res,r,sub){r.touch=Date.now();let chunks=[];req.on('data',d=>chunks.push(d));req.on('end',()=>{let data=Buffer.concat(chunks),h={...req.headers,host:`${HOST}:${r.port}`};delete h['content-length'];let p=http.request({host:HOST,port:r.port,path:sub,method:req.method,headers:h},up=>{let ct=String(up.headers['content-type']||'');if(req.method==='GET'&&ct.includes('text/html')){let a=[];up.on('data',d=>a.push(d));up.on('end',()=>{let out=badge(Buffer.concat(a).toString(),r),hh={...up.headers};delete hh['content-length'];hh['cache-control']='no-store';res.writeHead(up.statusCode||200,hh);res.end(out)})}else{res.writeHead(up.statusCode||502,up.headers);up.pipe(res)}});p.on('error',e=>{if(!res.headersSent)res.writeHead(502);res.end('A szoba szervere nem elérhető: '+e.message)});if(data.length)p.write(data);p.end()})}
const server=http.createServer(async(req,res)=>{let u=new URL(req.url,'http://local');if(req.method==='GET'&&u.pathname==='/'){res.writeHead(200,{'content-type':'text/html;charset=utf-8','cache-control':'no-store'});return res.end(landing())}if(req.method==='POST'&&u.pathname==='/api/rooms'){try{let r=await createRoom();setCookie(res,'ov_room_access',r.access,`/r/${encodeURIComponent(r.name)}/`);res.writeHead(200,{'content-type':'text/html;charset=utf-8','cache-control':'no-store'});return res.end(created(r))}catch(e){res.writeHead(503,{'content-type':'text/html;charset=utf-8'});return res.end(landing(e.message))}}let jm=u.pathname.match(/^\/join\/([^/]+)$/);if(req.method==='GET'&&jm){let r=rooms.get(decodeURIComponent(jm[1]).toUpperCase());if(!r)return deny(res);res.writeHead(200,{'content-type':'text/html;charset=utf-8','cache-control':'no-store'});return res.end(pinPage(r))}let am=u.pathname.match(/^\/api\/join\/([^/]+)$/);if(req.method==='POST'&&am){let r=rooms.get(decodeURIComponent(am[1]).toUpperCase());if(!r)return deny(res);let m=await readBody(req);if(clean(m.pin,4)!==r.pin){res.writeHead(403,{'content-type':'text/html;charset=utf-8'});return res.end(pinPage(r,'Hibás PIN.'))}setCookie(res,'ov_room_access',r.access,`/r/${encodeURIComponent(r.name)}/`);res.writeHead(303,{location:`/r/${encodeURIComponent(r.name)}/`});return res.end()}let x=u.pathname.match(/^\/r\/([^/]+)(\/.*)?$/);if(x){let r=rooms.get(decodeURIComponent(x[1]).toUpperCase());if(!r||!allowed(req,r))return deny(res);return proxy(req,res,r,(x[2]||'/')+u.search)}res.writeHead(404);res.end('Nincs ilyen oldal')});
setInterval(()=>{let n=Date.now();for(let[k,r]of rooms)if(n-r.touch>IDLE_MS){r.child.kill('SIGTERM');rooms.delete(k)}},60000);function stop(){for(let r of rooms.values())r.child.kill('SIGTERM');server.close(()=>process.exit())}process.on('SIGTERM',stop);process.on('SIGINT',stop);server.listen(PORT,'0.0.0.0',()=>console.log(`Room gateway alpha2.1: ${PORT}`));
