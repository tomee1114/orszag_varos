'use strict';
const http=require('http'),net=require('net'),{spawn}=require('child_process'),crypto=require('crypto'),qs=require('querystring');
const PORT=Number(process.env.PORT||80),HOST='127.0.0.1',MAX_ROOMS=10,IDLE_MS=7200000,rooms=new Map();
const clean=(s,n=64)=>String(s||'').replace(/[<>\x00-\x1f]/g,'').trim().slice(0,n);
const code5=()=>String(Math.floor(10000+Math.random()*90000)),pin4=()=>String(Math.floor(1000+Math.random()*9000)),pin6=()=>String(Math.floor(100000+Math.random()*900000)),token=()=>crypto.randomBytes(24).toString('hex');
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function parseCookies(req){return Object.fromEntries(String(req.headers.cookie||'').split(';').map(x=>x.trim().split('=').map(decodeURIComponent)).filter(x=>x[0]))}
function cookie(res,n,v,p){res.setHeader('Set-Cookie',`${encodeURIComponent(n)}=${encodeURIComponent(v)}; Path=${p}; HttpOnly; SameSite=Lax; Max-Age=7200`)}
function readBody(req){return new Promise((ok,no)=>{let b='';req.on('data',d=>{b+=d;if(b.length>16384)req.destroy()});req.on('end',()=>{try{ok(req.headers['content-type']?.includes('json')?JSON.parse(b||'{}'):qs.parse(b))}catch(e){no(e)}});req.on('error',no)})}
function freePort(){return new Promise((ok,no)=>{let s=net.createServer();s.listen(0,HOST,()=>{let p=s.address().port;s.close(()=>ok(p))});s.on('error',no)})}
function roomCode(){let c;do c=code5();while(rooms.has(c));return c}
function waitForPort(port,child,timeout=8000){return new Promise((ok,no)=>{let start=Date.now(),timer=setInterval(()=>{if(child.exitCode!==null){clearInterval(timer);return no(Error(`A szobaszerver leallt indulaskor (exit ${child.exitCode}).`))}let s=net.createConnection({host:HOST,port});s.once('connect',()=>{s.destroy();clearInterval(timer);ok()});s.once('error',()=>{s.destroy();if(Date.now()-start>timeout){clearInterval(timer);no(Error('A szobaszerver nem indult el 8 masodperc alatt.'))}})},100)})}
async function createRoom(){if(rooms.size>=MAX_ROOMS)throw Error('Most elertuk a 10 aktiv szobas korlatot.');let code=roomCode(),port=await freePort(),r={code,port,pin:pin4(),adminPin:pin6(),access:token(),hostToken:token(),locked:false,touch:Date.now()};let child=spawn(process.execPath,['server.js'],{cwd:__dirname,env:{...process.env,PORT:String(port)},stdio:['ignore','pipe','pipe']});r.child=child;rooms.set(code,r);child.stdout.on('data',d=>console.log(`[${code}] ${String(d).trim()}`));child.stderr.on('data',d=>console.error(`[${code}] ${String(d).trim()}`));child.on('exit',(c,s)=>{console.error(`[${code}] szobaszerver leallt: code=${c} signal=${s}`);rooms.delete(code)});try{await waitForPort(port,child);return r}catch(e){child.kill('SIGTERM');rooms.delete(code);throw e}}
function page(content,title='Orszag-Varos'){return`<!doctype html><html lang="hu"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title><style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui;background:radial-gradient(circle at 30% 15%,#523798,#17102f);color:#2a2140}.box{width:min(92%,540px);background:#fff;padding:1.4rem;border-radius:24px;box-shadow:0 20px 70px #0007}h1{color:#6842d8}.primary,button,.button{display:block;width:100%;border:0;border-radius:14px;padding:1rem;font:700 1.05rem system-ui;cursor:pointer;text-align:center;text-decoration:none}.primary{background:linear-gradient(135deg,#6842d8,#9262f4);color:#fff}input{width:100%;padding:1rem;border:2px solid #ddd3f6;border-radius:14px;font-size:1.1rem;margin:.5rem 0}.code{font-size:2.5rem;letter-spacing:.16em;text-align:center;color:#6842d8;font-weight:900}.secrets{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.secrets div{padding:.8rem;background:#f4f1ff;border-radius:14px;text-align:center}.secrets b{display:block;font-size:1.4rem}.warn{background:#fff0c8;padding:.7rem;border-radius:12px}.msg{background:#ffe5e5;padding:.7rem;border-radius:12px;color:#9d2531}.or{text-align:center;color:#827795;margin:1rem}.hint{color:#776d91;font-size:.9rem}</style></head><body><section class="box">${content}</section></body></html>`}
function landing(msg=''){return page(`<h1>🌍 Ország-Város</h1><p>Hozz létre új játékot, vagy csatlakozz szobakóddal és PIN-nel.</p>${msg?`<p class="msg">${esc(msg)}</p>`:''}<form method="post" action="/api/rooms"><button class="primary">＋ Új játék létrehozása</button></form><div class="or">vagy</div><form method="post" action="/api/join"><input name="code" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="5 jegyű szobakód" required><input name="pin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="4 jegyű belépési PIN" required><button>Csatlakozás</button></form>`)}
function created(r){return page(`<h1>✅ A szoba elkészült</h1><p class="code">${r.code}</p><div class="secrets"><div>Belépési PIN<b>${r.pin}</b></div><div>Admin PIN<b>${r.adminPin}</b></div></div><p class="warn">Az Admin PIN-t csak a házigazda ismerje.</p><a class="button primary" href="/r/${r.code}/">Belépés házigazdaként</a><p class="hint">TV: /r/${r.code}/tv</p>`,`Szoba ${r.code}`)}
function deny(res){res.writeHead(404,{'content-type':'text/html;charset=utf-8','cache-control':'no-store'});res.end(landing('A szobakód vagy a PIN nem megfelelő.'))}
const isHost=(req,r)=>parseCookies(req)[`ov_host_${r.code}`]===r.hostToken;
const hasAccess=(req,r)=>isHost(req,r)||parseCookies(req)[`ov_access_${r.code}`]===r.access;
function badge(html,r,host){let tag=`<script>window.OV_ROOM_CODE=${JSON.stringify(r.code)};(function(){function a(){if(document.getElementById('ov-room'))return;let e=document.createElement('div');e.id='ov-room';e.innerHTML='<small>Szobakód</small><b>${r.code}</b>${host?'<button id="ov-admin">⚙</button>':''}';document.body.appendChild(e);${host?`document.getElementById('ov-admin').onclick=async()=>{let p=prompt('Admin PIN');if(!p)return;let x=await fetch('/api/room/${r.code}/lock',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({pin:p})});let j=await x.json();alert(j.message||j.error)}`:''}}document.readyState==='loading'?document.addEventListener('DOMContentLoaded',a):a()})();</script><style>#ov-room{position:fixed;right:.7rem;bottom:.7rem;z-index:9999;display:flex;align-items:center;gap:.5rem;padding:.45rem .7rem;border-radius:14px;background:#17102ee8;color:#fff;font-family:system-ui;box-shadow:0 6px 22px #0006}#ov-room small{opacity:.7}#ov-room b{font-size:1.25rem;letter-spacing:.12em;color:#ffd765}#ov-room button{width:auto;padding:.25rem .45rem;background:#ffffff18;color:#fff}</style>`;return html.replace('</body>',tag+'</body>')}
function proxy(req,res,r,sub){r.touch=Date.now();let chunks=[];req.on('data',d=>chunks.push(d));req.on('end',()=>{let data=Buffer.concat(chunks);if(req.method==='POST'&&sub.startsWith('/api/action')){try{let m=JSON.parse(data.toString()||'{}');if(['start','settings','forceEnd','end','newGame','kick','tvKick'].includes(m.type)&&!isHost(req,r))return res.end(JSON.stringify({error:'Ezt csak a házigazda végezheti.'}))}catch{}}let h={...req.headers,host:`${HOST}:${r.port}`};delete h['content-length'];let p=http.request({host:HOST,port:r.port,path:sub,method:req.method,headers:h},up=>{let ct=String(up.headers['content-type']||'');if(req.method==='GET'&&ct.includes('text/html')){let a=[];up.on('data',d=>a.push(d));up.on('end',()=>{let out=badge(Buffer.concat(a).toString(),r,isHost(req,r)),hh={...up.headers};delete hh['content-length'];hh['cache-control']='no-store';res.writeHead(up.statusCode||200,hh);res.end(out)})}else{res.writeHead(up.statusCode||502,up.headers);up.pipe(res)}});p.on('error',e=>{if(!res.headersSent)res.writeHead(502);res.end('A szoba szervere nem elerheto: '+e.message)});if(data.length)p.write(data);p.end()})}
const server=http.createServer(async(req,res)=>{let u=new URL(req.url,'http://local');if(req.method==='GET'&&u.pathname==='/'){res.writeHead(200,{'content-type':'text/html;charset=utf-8','cache-control':'no-store'});return res.end(landing())}if(req.method==='POST'&&u.pathname==='/api/rooms'){try{let r=await createRoom();cookie(res,`ov_host_${r.code}`,r.hostToken,`/r/${r.code}/`);res.writeHead(200,{'content-type':'text/html;charset=utf-8','cache-control':'no-store'});return res.end(created(r))}catch(e){res.writeHead(503,{'content-type':'text/html;charset=utf-8'});return res.end(landing(e.message))}}if(req.method==='POST'&&u.pathname==='/api/join'){let m=await readBody(req),r=rooms.get(clean(m.code,5));if(!r||r.pin!==clean(m.pin,4)||r.locked)return deny(res);cookie(res,`ov_access_${r.code}`,r.access,`/r/${r.code}/`);res.writeHead(303,{location:`/r/${r.code}/`});return res.end()}let lm=u.pathname.match(/^\/api\/room\/(\d{5})\/lock$/);if(req.method==='POST'&&lm){let r=rooms.get(lm[1]);if(!r)return deny(res);let m=await readBody(req);if(!isHost(req,r)||clean(m.pin,6)!==r.adminPin)return res.end(JSON.stringify({error:'Hibás admin jogosultság.'}));r.locked=!r.locked;return res.end(JSON.stringify({message:r.locked?'A szoba lezárva.':'A szoba újra nyitva.'}))}let x=u.pathname.match(/^\/r\/(\d{5})(\/.*)?$/);if(x){let r=rooms.get(x[1]);if(!r||!hasAccess(req,r))return deny(res);return proxy(req,res,r,(x[2]||'/')+u.search)}res.writeHead(404);res.end('Nincs ilyen oldal')});
setInterval(()=>{let n=Date.now();for(let[c,r]of rooms)if(n-r.touch>IDLE_MS){r.child.kill('SIGTERM');rooms.delete(c)}},60000);function stop(){for(let r of rooms.values())r.child.kill('SIGTERM');server.close(()=>process.exit())}process.on('SIGTERM',stop);process.on('SIGINT',stop);server.listen(PORT,'0.0.0.0',()=>console.log(`Room gateway alpha2: ${PORT}`));
