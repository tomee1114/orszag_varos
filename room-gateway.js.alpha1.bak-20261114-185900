'use strict';
/* v2.4.0-alpha1: szobakezelo gateway a valtozatlan v2.2.7 jatekszerverek ele. */
const http=require('http'),net=require('net'),path=require('path'),{spawn}=require('child_process');
const PORT=Number(process.env.PORT||80),HOST='127.0.0.1',MAX_ROOMS=10,IDLE_MS=2*60*60*1000;
const rooms=new Map();
const cleanCode=s=>String(s||'').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^A-Z0-9-]/g,'').slice(0,16);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function code(){let c;do c=String(Math.floor(10000+Math.random()*90000));while(rooms.has(c));return c}
function freePort(){return new Promise((ok,no)=>{let s=net.createServer();s.listen(0,HOST,()=>{let p=s.address().port;s.close(()=>ok(p))});s.on('error',no)})}
async function createRoom(){if(rooms.size>=MAX_ROOMS)throw Error('Most elertuk a 10 aktiv szobas korlatot.');let c=code(),port=await freePort(),child=spawn(process.execPath,['server.js'],{cwd:__dirname,env:{...process.env,PORT:String(port)},stdio:['ignore','pipe','pipe']});let r={code:c,port,child,created:Date.now(),touch:Date.now(),ready:false};rooms.set(c,r);child.stdout.on('data',d=>{if(String(d).includes('porton'))r.ready=true});child.stderr.on('data',d=>console.error(`[${c}]`,String(d).trim()));child.on('exit',()=>rooms.delete(c));await new Promise(resolve=>setTimeout(resolve,350));return r}
function landing(message=''){return`<!doctype html><html lang="hu"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ország-Város szobák</title><style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui;background:radial-gradient(circle at 30% 15%,#523798,#17102f);color:#2a2140}.box{width:min(92%,520px);background:#fff;padding:1.4rem;border-radius:24px;box-shadow:0 20px 70px #0007}h1{color:#6842d8}.primary,button{display:block;width:100%;border:0;border-radius:14px;padding:1rem;font:700 1.05rem system-ui;cursor:pointer}.primary{background:linear-gradient(135deg,#6842d8,#9262f4);color:#fff}input{width:100%;padding:1rem;border:2px solid #ddd3f6;border-radius:14px;font-size:1.1rem;text-transform:uppercase;margin:.5rem 0}.or{text-align:center;color:#827795;margin:1rem}.msg{background:#ffe5e5;padding:.7rem;border-radius:12px;color:#9d2531}.hint{color:#776d91;font-size:.9rem}</style></head><body><section class="box"><h1>🌍 Ország-Város</h1><p>Hozz létre új családi játékot, vagy csatlakozz egy meglévő szobakóddal.</p>${message?`<p class="msg">${esc(message)}</p>`:''}<form method="post" action="/api/rooms"><button class="primary">＋ Új játék létrehozása</button></form><div class="or">vagy</div><form method="get" action="/join"><input name="code" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="one-time-code" placeholder="Például: 58321" required><button>Csatlakozás szobakóddal</button></form><p class="hint">Alpha1: minden szoba külön, változatlan v2.2.7 játékszervert kap. PIN és házigazda-jog a következő lépés.</p></section></body></html>`}
function roomMissing(res,c){res.writeHead(404,{'content-type':'text/html;charset=utf-8'});res.end(landing(`Nincs ilyen aktiv szoba: ${c}`))}
function proxy(req,res,room,subpath){room.touch=Date.now();let headers={...req.headers,host:`${HOST}:${room.port}`,'x-forwarded-prefix':`/r/${room.code}`};let p=http.request({host:HOST,port:room.port,path:subpath||'/',method:req.method,headers},up=>{let ct=String(up.headers['content-type']||'');if(req.method==='GET'&&ct.includes('text/html')){let chunks=[];up.on('data',d=>chunks.push(d));up.on('end',()=>{let html=Buffer.concat(chunks).toString('utf8');let tag=`<script>window.OV_ROOM_CODE=${JSON.stringify(room.code)};(function(){function add(){if(document.getElementById('ov-room-code'))return;let e=document.createElement('div');e.id='ov-room-code';e.innerHTML='<small>Szobakód</small><b>'+window.OV_ROOM_CODE+'</b>';document.body.appendChild(e)}document.readyState==='loading'?document.addEventListener('DOMContentLoaded',add):add()})();</script><style>#ov-room-code{position:fixed;right:1rem;bottom:1rem;z-index:9999;display:flex;align-items:center;gap:.55rem;padding:.5rem .75rem;border-radius:14px;background:#17102ee8;color:#fff;box-shadow:0 6px 22px #0006;font-family:system-ui}#ov-room-code small{opacity:.72}#ov-room-code b{font-size:1.35rem;letter-spacing:.12em;color:#ffd765}@media(max-width:600px){#ov-room-code{right:.5rem;bottom:.5rem;padding:.4rem .6rem}#ov-room-code b{font-size:1.1rem}}</style>`;html=html.replace('</body>',tag+'</body>');let h={...up.headers};delete h['content-length'];h['cache-control']='no-store';res.writeHead(up.statusCode||200,h);res.end(html)})}else{res.writeHead(up.statusCode||502,up.headers);up.pipe(res)}});p.on('error',e=>{if(!res.headersSent)res.writeHead(502,{'content-type':'text/plain;charset=utf-8'});res.end('A szoba szervere nem elerheto: '+e.message)});req.pipe(p)}
const server=http.createServer(async(req,res)=>{let u=new URL(req.url,'http://local');if(req.method==='GET'&&u.pathname==='/'){res.writeHead(200,{'content-type':'text/html;charset=utf-8','cache-control':'no-store'});return res.end(landing())}if(req.method==='POST'&&u.pathname==='/api/rooms'){try{let r=await createRoom();res.writeHead(303,{location:`/r/${r.code}/`});return res.end()}catch(e){res.writeHead(503,{'content-type':'text/html;charset=utf-8'});return res.end(landing(e.message))}}if(req.method==='GET'&&u.pathname==='/join'){let c=cleanCode(u.searchParams.get('code'));if(!rooms.has(c))return roomMissing(res,c);res.writeHead(303,{location:`/r/${c}/`});return res.end()}let m=u.pathname.match(/^\/r\/([A-Z0-9-]+)(\/.*)?$/);if(m){let c=cleanCode(m[1]),r=rooms.get(c);if(!r)return roomMissing(res,c);let sub=m[2]||'/';if(u.search)sub+=u.search;return proxy(req,res,r,sub)}res.writeHead(404);res.end('Nincs ilyen oldal')});
setInterval(()=>{let now=Date.now();for(let[c,r]of rooms)if(now-r.touch>IDLE_MS){r.child.kill('SIGTERM');rooms.delete(c)}},60000);
function stop(){for(let r of rooms.values())r.child.kill('SIGTERM');server.close(()=>process.exit(0));setTimeout(()=>process.exit(1),3000)}process.on('SIGTERM',stop);process.on('SIGINT',stop);server.listen(PORT,'0.0.0.0',()=>console.log(`Orszag-Varos room gateway: ${PORT}`));
