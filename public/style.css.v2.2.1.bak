:root{--vio:#6842d8;--vio2:#9a65ff;--ink:#281c43;--bg:#f4f1ff;--green:#20a967;--red:#df4949;--gold:#f5bd35}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",sans-serif}button,input,select{font:inherit}button{border:0;border-radius:14px;padding:.75rem 1rem;font-weight:800;cursor:pointer}.primary{background:linear-gradient(135deg,var(--vio),var(--vio2));color:white}.big{width:100%;font-size:1.3rem;margin:1rem 0;padding:1rem}header{position:sticky;top:0;z-index:10;background:linear-gradient(135deg,var(--vio),var(--vio2));color:white;padding:.7rem 1rem;display:flex;align-items:center;justify-content:space-between;box-shadow:0 5px 20px #36238644}header button{background:#ffffff22;color:#fff}main:not(.tv-lobby,.tv-draw,.tv-write,.tv-review,.tv-roundshow,.tv-final){max-width:780px;margin:auto;padding:1rem}.join{max-width:420px!important;text-align:center;padding-top:10vh!important}.join input{display:block;width:100%;padding:1rem;border:2px solid #ddd2ff;border-radius:14px;font-size:1.2rem;margin:1rem 0}.join a{display:block;margin:1rem}.card{background:#fff;border-radius:18px;padding:1rem;margin:.8rem 0;box-shadow:0 5px 18px #4c32941a}.draw{text-align:center;padding-top:4vh}.spinner{height:12rem;display:flex;align-items:center;justify-content:center;gap:1rem;position:relative}.spinner>*{display:grid;place-items:center;border-radius:25px;background:#fff;box-shadow:0 8px 30px #4f36a844;font-style:normal;font-weight:900;transition:.15s}.spinner strong{width:9rem;height:9rem;font-size:5rem;color:white;background:linear-gradient(135deg,var(--vio),#ff687e)}.spinner i{width:4rem;height:4rem;font-size:2rem}.spinner:before,.spinner:after{content:"";position:absolute;border:3px dashed #8055e855;border-radius:50%;width:12rem;height:12rem;animation:orbit 2.5s linear infinite;z-index:-1}.spinner:after{width:15rem;height:15rem;animation-direction:reverse}.spinner[data-fx="1"]{filter:hue-rotate(90deg);transform:scale(1.04) rotate(-2deg)}.spinner[data-fx="2"]{filter:hue-rotate(200deg);transform:scale(.97) rotate(2deg)}.stop{background:linear-gradient(135deg,#ff6262,#d83247);color:white;font-size:2rem;width:100%;max-width:420px}.letter{font-size:3.5rem;font-weight:900;text-align:center;color:white;background:linear-gradient(135deg,#ff843d,#ff507d);border-radius:22px;padding:.7rem;margin-bottom:.7rem}.fields{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem}.fields label{background:white;padding:.7rem;border-radius:15px;box-shadow:0 3px 12px #4c329418}.fields b{display:block;margin-bottom:.3rem}.fields input{width:100%;padding:.75rem;border:2px solid #ddd2ff;border-radius:11px}.chip,.empty{display:inline-block;padding:.45rem .7rem;border-radius:99px;background:#eee9ff;margin:.2rem}.chip.ok,.ready{background:#dcf7e9;color:#087e45}.timer{text-align:center;padding:.7rem;background:#fff;border:2px solid #d8caff;border-radius:15px;font-size:1.2rem}.timer.urgent{background:#ffe5e5;border-color:#f46b6b;color:#b11;animation:pulse .7s infinite alternate}.words{display:flex;flex-wrap:wrap;gap:.5rem}.word{display:flex;flex-direction:column;background:#dcf7e9;border:2px solid transparent}.word.x{text-decoration:line-through;background:#ffe2e2}.word.pending{background:#fff0c7;border-color:#f0b62f}.celebrate{text-align:center}.sparkles,.burst{font-size:5rem;animation:pop .8s infinite alternate}.result{display:grid;grid-template-columns:3rem 1fr 4rem;align-items:center;background:white;margin:.7rem;padding:1rem;border-radius:18px;box-shadow:0 4px 15px #452c8d22;animation:slide .6s calc(var(--i)*.2s) both}.result div{grid-column:2/4}.podium,.stats{text-align:center}.place{display:flex;align-items:center;gap:1rem;background:#fff;padding:1rem;margin:.7rem;border-radius:18px;animation:rise .7s calc(var(--i)*.5s) both}.place span{font-size:2rem}.place b{flex:1;text-align:left}.place em{font-size:1.2rem;font-weight:900}.p1{background:linear-gradient(135deg,#fff5b8,#ffd55a)}.stats{background:#fff;padding:1rem;border-radius:18px}.stats div{padding:.5rem}.confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden}.confetti i{position:absolute;top:-10%;width:10px;height:18px;background:hsl(calc(var(--n)*47),80%,55%);animation:fall 4s linear infinite}.confetti i:nth-child(3n){left:10%}.confetti i:nth-child(3n+1){left:50%}.confetti i:nth-child(3n+2){left:85%}.hide{display:none!important}#modal{position:fixed;inset:0;background:#24174588;z-index:20;display:grid;place-items:center}.sheet{background:white;width:min(92%,520px);padding:1.3rem;border-radius:22px}.sheet label,.sheet button{display:block;width:100%;margin:.65rem 0}.sheet select{float:right}#toast{position:fixed;bottom:1rem;left:50%;transform:translate(-50%,200%);background:#241745;color:#fff;padding:.8rem;border-radius:12px;transition:.3s;z-index:30}#toast.on{transform:translate(-50%,0)}
/* TV */body.tv{height:100vh;overflow:hidden;background:radial-gradient(circle at 60% 10%,#3a2b79,#130d2c);color:white}.tv #tv{display:grid;grid-template-columns:23vw 1fr;height:100vh}.tv aside{padding:2vw;background:#ffffff0c}.tv aside h2{font-size:2.3vw}.score{display:flex;justify-content:space-between;background:#ffffff12;padding:1vw;margin:.7vw 0;border-radius:1vw;font-size:1.5vw;border-left:.35vw solid hsl(calc(var(--c)*75 + 260),75%,65%)}.score span{font-size:2vw;font-weight:900}.tv main{padding:2vw 3vw;overflow:auto}.tv-lobby{text-align:center}.tv-lobby h1{font-size:5vw}.tv-lobby code{font-size:2.5vw;background:#ffffff18;padding:1vw;border-radius:1vw}.tv-lobby span{display:inline-block;background:#fff;color:var(--ink);padding:.7vw 1vw;border-radius:2vw;margin:2vw .5vw}.tv-draw{text-align:center}.tv-draw h2{font-size:3vw}.tv .spinner{height:27vw}.tv .spinner strong{width:18vw;height:18vw;font-size:11vw}.tv .spinner i{width:8vw;height:8vw;font-size:4vw}.tv .spinner:before{width:24vw;height:24vw}.tv .spinner:after{width:31vw;height:31vw}.heroletter{text-align:center;font-size:7vw;font-weight:900}.progresses{display:grid;gap:1vw}.progress{animation:slide .5s calc(var(--i)*.12s) both}.pname{display:flex;justify-content:space-between;font-size:1.7vw}.track{height:2.2vw;background:#ffffff17;border-radius:2vw;overflow:hidden;position:relative}.track i{display:block;width:var(--pct);height:100%;background:linear-gradient(90deg,#7650ed,#ff5e82,#ffc53d);transition:width .5s cubic-bezier(.2,1.5,.4,1)}.track u{position:absolute;inset:0;background:linear-gradient(100deg,transparent 35%,#ffffff99 50%,transparent 65%);animation:shine 1.4s linear infinite}.progress.done .track i{background:linear-gradient(90deg,#16a764,#70e39e);animation:readyglow .8s infinite alternate}.icons{display:flex;gap:.4vw;margin-top:.3vw}.icons span{font-size:1.5vw;filter:grayscale(1);opacity:.25;transform:scale(.7);transition:.4s}.icons span.lit{filter:none;opacity:1;transform:scale(1);animation:iconpop .5s}.tvtimer{text-align:center;font-size:2vw;padding:.5vw}.tvtimer b{font-size:4vw}.tvtimer.urgent{color:#ff6262;animation:pulse .6s infinite alternate}.reviewgrid{display:grid;grid-template-columns:12vw repeat(7,1fr);font-size:1.2vw;background:#fff;color:var(--ink);border-radius:1.2vw;overflow:hidden}.reviewgrid>*{padding:.7vw;border:1px solid #eee}.reviewgrid b{text-align:center}.reviewgrid small{display:block}.cell.x{text-decoration:line-through;background:#ffe0e0}.cell.pending{background:#fff0bd}.tv-roundshow{text-align:center}.tv-roundshow h1{font-size:3.5vw}.roundrow{display:grid;grid-template-columns:4vw 13vw 1fr 5vw;align-items:center;gap:1vw;margin:1vw;background:#ffffff12;border-radius:1vw;padding:.8vw;animation:slide .7s calc(var(--i)*.3s) both}.roundrow>span{font-size:2.5vw}.roundrow>b{font-size:2vw}.roundrow>div{height:1.5vw;background:#ffffff17;border-radius:1vw;overflow:hidden}.roundrow>div i{display:block;width:var(--w);height:100%;background:linear-gradient(90deg,#713fd5,#ffbd35);animation:grow 1s calc(var(--i)*.3s + .5s) both}.roundrow em{font-size:2.3vw;color:#ffd45a}.roundrow u{grid-column:2/5;text-align:left;text-decoration:none;font-size:1.5vw}.tv-final{text-align:center}.tv-final h1{font-size:4vw}.tvpodium{display:flex;flex-direction:column;gap:.7vw}.tvplace{display:flex;align-items:center;gap:1vw;padding:1vw 2vw;border-radius:1.2vw;background:#ffffff13;font-size:2vw;animation:rise .8s calc(var(--i)*.7s) both}.tvplace span{font-size:3vw}.tvplace b{flex:1;text-align:left}.tvplace.p1{background:linear-gradient(135deg,#ffde6a55,#ffad3255)}.awards{display:grid;grid-template-columns:repeat(4,1fr);gap:1vw;margin-top:2vw}.awards article{background:#ffffff12;border-radius:1vw;padding:1vw;font-size:2.5vw;animation:pop .6s 2.2s both}.awards b,.awards span{display:block;font-size:1.1vw}.reduced *{animation:none!important;transition:none!important}
@media(max-width:600px){.fields{grid-template-columns:1fr}.letter{font-size:2.5rem}}@keyframes orbit{to{transform:rotate(360deg)}}@keyframes pop{from{transform:scale(.2);opacity:0}to{transform:scale(1);opacity:1}}@keyframes slide{from{transform:translateX(-50px);opacity:0}}@keyframes rise{from{transform:translateY(80px);opacity:0}}@keyframes grow{from{width:0}}@keyframes shine{from{transform:translateX(-100%)}to{transform:translateX(100%)}}@keyframes readyglow{to{filter:brightness(1.5)}}@keyframes iconpop{50%{transform:scale(1.4)}}@keyframes pulse{to{transform:scale(1.04)}}@keyframes fall{to{transform:translateY(120vh) rotate(720deg)}}

/* v2.2.1 finomítások */
.track u{display:none}.progress:not(.done) .track:after{content:"";position:absolute;inset:0 auto 0 -25%;width:18%;background:linear-gradient(90deg,transparent,#ffffff75,transparent);animation:calmshine 3.2s ease-in-out infinite}.icons span{animation:none!important}.icons span.just-lit{animation:iconpop .55s ease!important}.progress.done .track i{animation:doneonce .7s ease 1!important;filter:none}.tv-help{text-align:center;color:#d9d0ff;font-size:1.2vw;margin-top:1vw}.cell.ok{background:#e3f7ec}.cell.x{background:#ffe0e0;text-decoration:line-through;text-decoration-thickness:3px}.cell.pending{background:#fff0bd}
.round-hero{display:flex;align-items:center;justify-content:center;gap:2vw;margin-bottom:1.4vw}.round-hero>span{font-size:3.5vw;animation:pop 1s ease infinite alternate}.round-hero small{font-size:1.3vw;color:#d8cff9}.round-hero h1{font-size:5vw;line-height:1;margin:.15vw}.round-hero p{font-size:1.5vw;margin:0;color:#d8cff9;text-transform:uppercase;letter-spacing:.25em}.roundcards{display:grid;gap:.8vw}.roundcard{display:grid;grid-template-columns:5vw 1fr 9vw;align-items:center;gap:1.2vw;background:linear-gradient(110deg,#ffffff13,#ffffff08);border:1px solid #ffffff18;border-radius:1.2vw;padding:.8vw 1.2vw;animation:slide .65s calc(var(--i)*.22s) both;box-shadow:0 .6vw 2vw #00000020}.roundcard.winner{background:linear-gradient(110deg,#ffd75d30,#ff9f3230);border-color:#ffd75d80}.avatar{font-size:3vw}.rinfo{text-align:left}.rinfo>b{font-size:1.8vw}.rbar{height:.75vw;background:#ffffff18;border-radius:1vw;margin:.45vw 0;overflow:hidden}.rbar i{display:block;height:100%;width:var(--w);background:linear-gradient(90deg,#8f6cff,#ff6b8a,#ffd75d);border-radius:1vw;animation:grow 1s calc(.4s + var(--i)*.2s) both}.coins{display:flex;gap:.35vw}.coins span{font-size:1vw;color:#ffffff22}.coins span.earned{color:#ffd75d;text-shadow:0 0 .6vw #ffc83d}.rpoints{display:flex;flex-direction:column;text-align:center}.rpoints small{font-size:.8vw;color:#d8cff9}.rpoints strong{font-size:3vw;color:#ffd75d;line-height:1}.rpoints em{font-size:1vw}.next-round{text-align:center;margin-top:1.2vw;color:#cfc5f3;font-size:1.1vw}
.wordsheet .wordmeta{color:#746a91}.selectedword{font-size:2.3rem;font-weight:900;margin:.35rem 0 1rem}.wide{display:block;width:100%;margin:.55rem 0}.danger{background:#dc404b;color:#fff}.good{background:#1f9d62;color:#fff}.decision{padding:.75rem;border-radius:12px;margin:.6rem 0;font-weight:750}.decision.bad{background:#ffe3e3;color:#a7202a}.decision.pending{background:#fff0c5;color:#855800}.modalhint{font-size:.9rem;color:#746a91;text-align:center}
@keyframes calmshine{0%,55%{left:-25%;opacity:0}70%{opacity:.65}100%{left:110%;opacity:0}}@keyframes doneonce{50%{filter:brightness(1.4);transform:scaleY(1.12)}}
