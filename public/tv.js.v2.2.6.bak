const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
let S=null,lastPhase='',spin=null,offset=0;
const TV_ADMIN_ID=sessionStorage.ov_tv_admin||(sessionStorage.ov_tv_admin='tv-'+Math.random().toString(36).slice(2));new EventSource('events?tv=1&id='+encodeURIComponent(TV_ADMIN_ID)).onmessage=e=>{S=JSON.parse(e.data);offset=S.now-Date.now();render()};
async function tvAdminAction(type,data={}){let r=await fetch('api/action',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({id:TV_ADMIN_ID,type,...data})}),j=await r.json();if(j.error)alert(j.error);return j;}
function openPlayerManager(){document.querySelector('#player-manager')?.classList.add('open');refreshPlayerManager()}
function closePlayerManager(){document.querySelector('#player-manager')?.classList.remove('open')}
function refreshPlayerManager(){let e=document.querySelector('#player-manager-list');if(!e||!S)return;e.innerHTML=S.players.length?S.players.map(p=>`<article class="manager-player ${p.online?'':'offline'}"><div><b>${esc(p.name)}</b><small>${p.online?'● online':'○ kapcsolat nélkül'} · ${p.score} pont</small></div><button onclick="kickPlayer('${p.id}')">Kidobás</button></article>`).join(''):'<p>Nincs játékos.</p>';}
async function kickPlayer(id){let p=S.players.find(x=>x.id===id);if(!p||!confirm(`Biztosan kidobod: ${p.name}?`))return;gameAudio?.play('remove');await tvAdminAction('tvKick',{target:id});refreshPlayerManager()}
function sidebar(){let a=[...S.players].sort((x,y)=>y.score-x.score);return`<aside><h2>🏆 Állás</h2><p>${S.round?S.round+'. kör':''}</p>${a.map((p,i)=>`<div class="score" style="--c:${i}"><b>${esc(p.name)}</b><span>${p.score}</span></div>`).join('')}<button class="player-manager-button" onclick="openPlayerManager()">👥 Játékosok kezelése</button></aside>`}
function render(){document.body.classList.toggle('reduced',S.reduced);let phaseKey=S.phase+'-'+S.round;
 if(S.phase==='writing'&&lastPhase===phaseKey){updateWriting();updateSide();return}
 if(S.phase==='review'&&lastPhase===phaseKey){updateReview();return}
 lastPhase=phaseKey;clearInterval(spin);let main='';
 if(S.phase==='lobby')main=`<main class="tv-lobby"><h1>🌍 Ország-Város</h1><p>Csatlakozás:</p><code>${esc(location.origin+'/')}</code><div>${S.players.map(p=>`<span>${esc(p.name)}</span>`).join('')}</div></main>`;
 if(S.phase==='drawing')main=`<main class="tv-draw"><h2>${esc(S.players.find(p=>p.id===S.drawer)?.name)} sorsol…</h2><div class="spinner"><i>✦</i><strong>?</strong><i>◆</i></div><p>Az eredmény csak a STOP után derül ki</p></main>`;
 if(S.phase==='writing')main=writingShell(); if(S.phase==='review')main=review(); if(S.phase==='roundshow')main=roundshow(); if(S.phase==='final')main=final();
 $('#tv').innerHTML=sidebar()+main;if(!document.querySelector('#player-manager'))document.body.insertAdjacentHTML('beforeend',`<div id="player-manager" class="player-manager-overlay"><section><header><div><small>TV vezérlő</small><h2>Játékosok kezelése</h2></div><button onclick="closePlayerManager()">✕</button></header><p>A Kidobás azonnal eltávolítja a játékost. A telefonon újra megjelenik a belépőoldal.</p><div id="player-manager-list"></div></section></div>`);if(document.querySelector('#player-manager.open'))refreshPlayerManager();if(S.phase==='lobby'){let lm=document.querySelector('.tv-lobby');if(lm&&!lm.querySelector('.sound-unlock'))lm.insertAdjacentHTML('beforeend','<button class="sound-unlock" onclick="enableTvSound()">🔊 Hangok aktiválása</button>');}if(S.phase==='lobby'){let lm=document.querySelector('.tv-lobby');if(lm&&!document.querySelector('.qr-join-panel'))lm.insertAdjacentHTML('beforeend',`<section class="qr-join-panel"><div id="joinqr" class="joinqr"></div><div class="qr-copy"><span>📱</span><h2>Csatlakozás telefonról</h2><p>Olvasd be a QR-kódot a telefon vagy tablet kamerájával</p><code id="joinurl"></code><small>A készülék legyen ugyanazon a helyi hálózaton</small></div></section>`);renderJoinQR();}if(S.phase==='drawing')startSpin();if(S.phase==='writing'){updateWriting();tick()}if(S.phase==='review')updateReview()}
function updateSide(){let box=$('aside');if(!box)return;let rows=[...S.players].sort((a,b)=>b.score-a.score);box.querySelectorAll('.score').forEach((el,i)=>{let p=rows[i];if(p){el.querySelector('b').textContent=p.name;el.querySelector('span').textContent=p.score}})}
function joinAddress(){const forced=new URLSearchParams(location.search).get('join');if(forced)return forced.endsWith('/')?forced:forced+'/';return new URL('/',location.href).href;}
function renderJoinQR(){const host=document.querySelector('#joinqr');if(!host||host.dataset.ready)return;const url=joinAddress();host.dataset.ready='1';host.innerHTML='';try{host.appendChild(makeQR(url,300))}catch(e){host.innerHTML='<div class="qr-error">A QR-kód nem készíthető el</div>'}const text=document.querySelector('#joinurl');if(text)text.textContent=url;}
function startSpin(){let pool=['A','CS','É','GY','K','NY','Ó','P','SZ','TY','Ü','ZS','✦','?','●','◆'];spin=setInterval(()=>{document.querySelectorAll('.spinner>*').forEach(x=>x.textContent=pool[Math.floor(Math.random()*pool.length)]);$('.spinner').dataset.fx=Math.floor(Math.random()*3)},80)}
function writingShell(){return`<main class="tv-write"><div class="heroletter">${esc(S.label)}</div><div id="tvtimer"></div><div class="progresses">${S.players.map((p,i)=>`<div class="progress" data-player="${p.id}" style="--i:${i}"><div class="pname"><b>${esc(p.name)}</b><span></span></div><div class="track"><i></i><u></u></div><div class="icons">${S.cats.map(c=>`<span>${c.icon}</span>`).join('')}</div></div>`).join('')}</div></main>`}
function updateWriting(){for(const p of S.players){let row=document.querySelector(`[data-player="${CSS.escape(p.id)}"]`);if(!row)continue;let old=+(row.dataset.filled||0);row.dataset.filled=p.filled;row.classList.toggle('done',p.done);row.querySelector('.pname span').textContent=p.done?'✅ Kész':p.filled+'/7';row.querySelector('.track i').style.width=(p.filled/7*100)+'%';row.querySelectorAll('.icons span').forEach((x,j)=>{let lit=j<p.filled;if(lit&&!x.classList.contains('lit')&&j>=old){x.classList.add('just-lit');setTimeout(()=>x.classList.remove('just-lit'),650)}x.classList.toggle('lit',lit)})}tick()}
function tick(){if(!S||S.phase!=='writing')return;let e=$('#tvtimer');if(!e)return;if(!S.endsAt){e.innerHTML='';return}let sec=Math.max(0,Math.ceil((S.endsAt-(Date.now()+offset))/1000));e.innerHTML=`<div class="tvtimer ${sec<=10?'urgent':''}">${S.endReason==='rule'?'A szabály aktiválódott!':'Hátralévő idő'} <b>${sec}</b></div>`}setInterval(tick,250)
function markMeta(m,w){
 if(!w)return{cls:'empty',icon:'—',sub:'Nincs válasz'};
 if(m?.s==='x'){let why=m.r==='dup'?'Más is ugyanezt írta':m.r==='letter'?'Rossz kezdőbetű':'Kihúzva';return{cls:'rejected',icon:'✕',sub:why}}
 if(m?.s==='pending')return{cls:'pending',icon:'?',sub:(m.byName?m.byName+' jelölte':'Döntésre vár')};
 return{cls:'accepted',icon:'✓',sub:'Érvényes'};
}
function review(){return`<main class="tv-review category-review"><div class="category-review-title"><div><small>${S.round}. kör összegzése</small><h1>${esc(S.label)}</h1><p>A válaszok kategóriánként · a telefonokon lehet dönteni</p></div><div class="review-legend"><span class="lg-ok">✓ Érvényes</span><span class="lg-pending">? Döntésre vár</span><span class="lg-x">✕ Kihúzva</span></div></div><div class="category-columns">${S.cats.map((c,ci)=>`<section class="category-column" style="--ci:${ci}"><header><span>${c.icon}</span><div><b>${esc(c.label)}</b><small data-cat-summary="${c.key}"></small></div></header><div class="category-answers">${S.players.map(p=>`<article class="category-answer" data-cell="${p.id}|${c.key}"><div class="answer-player">${esc(p.name)}</div><div class="answer-word">—</div><div class="answer-reason"></div><div class="answer-state">—</div></article>`).join('')}</div></section>`).join('')}</div><div class="acknowledge-bar"><div class="ack-title"><span class="live-dot"></span><b>Játékosok láttamozása</b><small>A köreredmény automatikusan indul, amikor mindenki megnyomta a „Láttam, rendben” gombot.</small></div><div class="tv-ack-players">${S.players.map(p=>`<span data-ack="${p.id}"><i>○</i>${esc(p.name)}</span>`).join('')}</div><strong id="ackcount">0 / ${S.players.length}</strong></div></main>`}
function updateReview(){
 for(const c of S.cats){let good=0,pending=0,bad=0;
  for(const p of S.players){let e=document.querySelector(`[data-cell="${CSS.escape(p.id+'|'+c.key)}"]`),w=S.answers?.[p.id]?.[c.key]||'',m=S.marks?.[p.id]?.[c.key],z=markMeta(m,w);if(!e)continue;let old=e.dataset.state;e.dataset.state=z.cls;e.className='category-answer '+z.cls;e.querySelector('.answer-word').textContent=w||'—';e.querySelector('.answer-reason').textContent=z.sub;e.querySelector('.answer-state').textContent=z.icon;if(old&&old!==z.cls){e.classList.add('state-changed');setTimeout(()=>e.classList.remove('state-changed'),700)}if(z.cls==='accepted')good++;if(z.cls==='pending')pending++;if(z.cls==='rejected')bad++}
  let sm=document.querySelector(`[data-cat-summary="${CSS.escape(c.key)}"]`);if(sm)sm.textContent=pending?pending+' döntésre vár':bad?good+' jó · '+bad+' kihúzva':good+' érvényes válasz';
 }
 let seen=S.reviewSeen||{},n=Object.keys(seen).length;let count=document.querySelector('#ackcount');if(count)count.textContent=n+' / '+S.players.length;
 for(const p of S.players){let e=document.querySelector(`[data-ack="${CSS.escape(p.id)}"]`);if(e){e.classList.toggle('seen',!!seen[p.id]);e.querySelector('i').textContent=seen[p.id]?'✓':'○'}}
}
function roundshow(){let rows=[...S.show.rows].sort((a,b)=>b.pts-a.pts),max=Math.max(...rows.map(x=>x.pts),1),top=rows[0]?.pts;return`<main class="tv-roundshow"><div class="round-hero"><span>✨</span><div><small>${S.round}. kör</small><h1>${esc(S.label)}</h1><p>Köreredmény</p></div><span>✨</span></div><div class="roundcards">${rows.map((r,i)=>`<article class="roundcard ${r.pts===top?'winner':''}" style="--i:${i}"><div class="avatar">${r.pts===top?'🏆':'⭐'}</div><div class="rinfo"><b>${esc(r.name)}</b><div class="rbar"><i style="--w:${r.pts/max*100}%"></i></div><div class="coins">${Array.from({length:7},(_,j)=>`<span class="${j<r.pts?'earned':''}">●</span>`).join('')}</div></div><div class="rpoints"><small>ebben a körben</small><strong>+${r.pts}</strong><em>pont</em></div></article>`).join('')}</div><div class="next-round">A következő kör hamarosan indul…</div></main>`}
function final(){let a=[...S.players].sort((x,y)=>y.score-x.score),st=S.stats||{},pp=st.players||[],best=[...pp].sort((x,y)=>y.good-x.good)[0],fast=[...pp].sort((x,y)=>y.fast-x.fast)[0],perfect=[...pp].sort((x,y)=>y.perfect-x.perfect)[0];return`<main class="tv-final"><div class="confetti">${'<i></i>'.repeat(70)}</div><h1>🏆 Eredményhirdetés</h1><div class="tvpodium">${a.map((p,i)=>`<div class="tvplace p${i+1}" style="--i:${i}"><span>${['🥇','🥈','🥉'][i]||i+1+'.'}</span><b>${esc(p.name)}</b><em>${p.score} pont</em></div>`).join('')}</div><div class="awards">${best?`<article>🧠<b>Szókirály</b><span>${esc(best.name)} · ${best.good}</span></article>`:''}${fast?`<article>⚡<b>Villámkéz</b><span>${esc(fast.name)} · ${fast.fast}</span></article>`:''}${perfect?.perfect?`<article>🌟<b>Tökéletes kör</b><span>${esc(perfect.name)} · ${perfect.perfect}</span></article>`:''}${st.longest?`<article>📏<b>Leghosszabb szó</b><span>${esc(st.longest)}</span></article>`:''}</div></main>`}

function fitTvReview(){if(!S)return;document.documentElement.style.setProperty('--tv-player-count',Math.max(1,S.players.length));let compact=S.players.length>=7?'micro':S.players.length>=5?'compact':'normal';document.body.dataset.density=compact;}
let _tvAudioPhase='',_tvTick=-1;
function tvAudioWatch(){if(!S||!window.gameAudio)return;fitTvReview();gameAudio.setEnabled(S.sound!==false);if(S.phase!==_tvAudioPhase){if(S.phase==='drawing')gameAudio.startRoll();if(S.phase==='writing'&&_tvAudioPhase==='drawing')gameAudio.stopRoll();if(S.phase==='roundshow')gameAudio.play('round');if(S.phase==='final')gameAudio.play('winner');_tvAudioPhase=S.phase}if(S.phase==='writing'&&S.endsAt){let n=Math.ceil((S.endsAt-(Date.now()+offset))/1000);if(n<=5&&n>=1&&n!==_tvTick){_tvTick=n;gameAudio.play('tick')}}}
setInterval(tvAudioWatch,200);
function enableTvSound(){gameAudio.open();gameAudio.play('done');localStorage.ov_tv_sound='1';document.querySelector('.sound-unlock')?.classList.add('enabled')}
